# VirtueMart product importer configuration
# Copy to .env and fill in. NEVER commit the real .env file.

# --- database (MariaDB of the Joomla installation) ---------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=support_manouka_
DB_USER=
DB_PASSWORD=

# Use DB_BACKEND=sqlite only for local testing against a restored copy of the
# SQL dump (DB_NAME then holds the sqlite file path).
DB_BACKEND=mysql

# --- paths --------------------------------------------------------------------
# CSV_PATH=products.csv
IMAGES_PATH=images

# Absolute path of the VirtueMart product image directory ON THE SERVER
# (discovered in the analysis from virtuemart_configs; the importer copies
# files there directly, e.g. over SSHFS/SCP mount):
VM_MEDIA_DIR=/home/support/web/libertidance.com/public_html/images/stories/virtuemart/product

LOG_DIR=logs

# --- VirtueMart conventions -----------------------------------------------------
# Joomla user id written to created_by / modified_by.
# 119 = "Liberti Dancewear" (libertidance) in the current installation.
VM_ADMIN_USER_ID=119

# VAT percent of calc rule 1 ("VAT 24%"). Only used with --price-mode gross.
VM_VAT_RATE=24

# PRICE_MODE=net  -> CSV price is stored verbatim as the NET price (recommended;
#                    this is what the database stores).
# PRICE_MODE=gross-> CSV price is treated as VAT-inclusive and divided by 1.24.
PRICE_MODE=net
